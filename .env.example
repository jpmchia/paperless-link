PAPERLESS_API_URL=https://paperless.example.com/
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=https://link.example.com
LINK_IQ_API_URL=http://127.0.0.1:8080/api/v1
# Optional: override Link-IQ request timeout in milliseconds (default 30000)
# LINK_IQ_REQUEST_TIMEOUT_MS=60000

# Optional: direct Paperless websocket endpoint for realtime features
# NEXT_PUBLIC_PAPERLESS_WS_URL=wss://paperless.example.com/ws/status/

# Optional: enable Next bundle analyzer during build
# ANALYZE=false
