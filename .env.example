PAPERLESS_API_URL=https://paperless.example.com/
# Optional: Paperless API version accepted by NGX v3 (9 or 10). Defaults to 10.
# PAPERLESS_API_VERSION=10
# Optional service-account fallback. Prefer per-user session tokens from login.
# PAPERLESS_API_TOKEN=
# Public URL used for browser redirects (same origin as Link under reverse proxy).
# PAPERLESS_PUBLIC_URL=https://link.example.com/paperless/
# Internal URL used for server-to-server calls when different from PAPERLESS_API_URL.
# PAPERLESS_INTERNAL_URL=http://paperless:8000/
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=https://link.example.com
LINK_IQ_API_URL=http://127.0.0.1:8080/api/v1
# Optional: override Link-IQ request timeout in milliseconds (default 30000)
# LINK_IQ_REQUEST_TIMEOUT_MS=60000

# Optional: direct Paperless websocket endpoint for realtime features
# NEXT_PUBLIC_PAPERLESS_WS_URL=wss://paperless.example.com/ws/status/

# Optional: enable Next bundle analyzer during build
# ANALYZE=false
